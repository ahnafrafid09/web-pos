generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

/**
 * |--------------------------------------------------------------------------
 * | ENUMS
 * |--------------------------------------------------------------------------
 */

enum UserRole {
  SUPER_ADMIN
  OWNER
  ADMIN
  CASHIER
}

enum ProductType {
  MENU
  MERCHANDISE
}

enum StockMovementType {
  PURCHASE
  RECIPE_USAGE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  WASTE
  RETURN
}

enum TransactionStatus {
  PENDING
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PurchaseType {
  PO
  DIRECT
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  PARTIAL
  RECEIVED
  COMPLETED
  CANCELLED
}

enum PurchasePaymentStatus {
  UNPAID
  PARTIAL
  PAID
}

enum AdjustmentType {
  PERCENTAGE
  FIXED
}

enum PaymentMethodUsage {
  PURCHASE
  TRANSACTION
  BOTH
}

enum AuditLogAction {
  CREATE
  UPDATE
  DELETE
  REGISTER
  LOGIN
  LOGIN_FAILED
  LOGOUT
}

enum ModuleCode {
  SALES
  INVENTORY
  PURCHASE
  RECIPE
  REPORTING
}

enum TenantModuleStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  SUSPENDED
}

/**
 * |--------------------------------------------------------------------------
 * | TENANT
 * |--------------------------------------------------------------------------
 */

model Tenant {
  id   String @id @default(uuid())
  name String @db.VarChar(150)
  code String @unique @db.VarChar(50)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users              User[]
  modules            TenantModule[]
  categories         Category[]
  products           Product[]
  rawMaterials       RawMaterial[]
  suppliers          Supplier[]
  purchases          Purchase[]
  stockMovements     StockMovement[]
  transactions       Transaction[]
  paymentMethods     PaymentMethod[]
  refreshTokens      RefreshToken[]
  auditLogs          AuditLog[]
  transactionSetting TransactionSetting?

  @@index([isActive])
  @@map("tenant")
}

/**
 * |--------------------------------------------------------------------------
 * | MODULE
 * |--------------------------------------------------------------------------
 */

model Module {
  id   String     @id @default(uuid())
  code ModuleCode @unique
  name String     @db.VarChar(100)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenants TenantModule[]

  @@index([isActive])
  @@map("module")
}

/**
 * |--------------------------------------------------------------------------
 * | TENANT MODULE
 * |--------------------------------------------------------------------------
 */

model TenantModule {
  id String @id @default(uuid())

  tenantId String @map("tenant_id")
  moduleId String @map("module_id")

  status    TenantModuleStatus @default(ACTIVE)
  startedAt DateTime?          @map("started_at")
  expiredAt DateTime?          @map("expired_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Restrict)

  @@unique([tenantId, moduleId])
  @@index([tenantId, status])
  @@index([moduleId])
  @@index([expiredAt])
  @@map("tenant_module")
}

/**
 * |--------------------------------------------------------------------------
 * | USER
 * |--------------------------------------------------------------------------
 */

model User {
  id String @id @default(uuid())

  tenantId String? @map("tenant_id")

  name     String  @db.VarChar(150)
  username String  @db.VarChar(100)
  email    String? @db.VarChar(150)
  password String  @db.VarChar(255)

  role UserRole

  isActive Boolean @default(true) @map("is_active")

  lastLoginAt DateTime? @map("last_login_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  transactions  Transaction[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@unique([tenantId, username])
  @@index([tenantId])
  @@index([tenantId, role])
  @@index([tenantId, isActive])
  @@index([email])
  @@map("user")
}

/**
 * |--------------------------------------------------------------------------
 * | CATEGORY
 * |--------------------------------------------------------------------------
 */

model Category {
  id String @id @default(uuid())

  tenantId String @map("tenant_id")

  name     String  @db.VarChar(100)
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  products Product[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("category")
}

/**
 * |--------------------------------------------------------------------------
 * | PRODUCT
 * |--------------------------------------------------------------------------
 */

model Product {
  id String @id @default(uuid())

  tenantId   String  @map("tenant_id")
  categoryId String? @map("category_id")

  name String  @db.VarChar(150)
  sku  String? @db.VarChar(100)

  type ProductType

  unit String @db.VarChar(50)

  sellingPrice Int @map("selling_price")
  hpp          Int @default(0)

  imageUrl String? @map("image_url") @db.Text
  imageKey String? @map("image_key") @db.VarChar(255)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  recipeItems      RecipeItem[]
  transactionItems TransactionItem[]

  @@unique([tenantId, sku])
  @@index([tenantId])
  @@index([tenantId, categoryId])
  @@index([tenantId, type])
  @@index([tenantId, isActive])
  @@index([tenantId, name])
  @@map("product")
}

/**
 * |--------------------------------------------------------------------------
 * | RAW MATERIAL
 * |--------------------------------------------------------------------------
 */

model RawMaterial {
  id String @id @default(uuid())

  tenantId String @map("tenant_id")
  unitId   String @map("unit_id")

  name String  @db.VarChar(150)
  code String? @db.VarChar(100)

  averageCost Int @default(0) @map("average_cost")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unit   Unit   @relation(fields: [unitId], references: [id], onDelete: Restrict)

  stock Stock?

  recipeItems RecipeItem[]

  purchaseItems PurchaseItem[]

  stockMovements StockMovement[]

  unitConversions RawMaterialUnitConversion[]

  @@unique([tenantId, name])
  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, unitId])
  @@index([tenantId, isActive])
  @@map("raw_material")
}

/**
 * |--------------------------------------------------------------------------
 * | STOCK
 * |--------------------------------------------------------------------------
 */

model Stock {
  id String @id @default(uuid())

  rawMaterialId String @unique @map("raw_material_id")

  quantity Decimal @default(0) @db.Decimal(15, 3)

  minQuantity Decimal? @map("min_quantity") @db.Decimal(15, 3)
  maxQuantity Decimal? @map("max_quantity") @db.Decimal(15, 3)

  updatedAt DateTime @updatedAt @map("updated_at")

  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)

  @@map("stock")
}

/**
 * |--------------------------------------------------------------------------
 * | RECIPE ITEM
 * |--------------------------------------------------------------------------
 */

model RecipeItem {
  id String @id @default(uuid())

  productId     String @map("product_id")
  rawMaterialId String @map("raw_material_id")

  quantity Decimal @db.Decimal(15, 3)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product     Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)

  @@unique([productId, rawMaterialId])
  @@index([productId])
  @@index([rawMaterialId])
  @@map("recipe_item")
}

/**
 * |--------------------------------------------------------------------------
 * | SUPPLIER
 * |--------------------------------------------------------------------------
 */

model Supplier {
  id String @id @default(uuid())

  tenantId String @map("tenant_id")

  code String @db.VarChar(50)
  name String @db.VarChar(150)

  phone   String? @db.VarChar(30)
  email   String? @db.VarChar(150)
  address String? @db.Text

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchases Purchase[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, name])
  @@map("supplier")
}

/**
 * |--------------------------------------------------------------------------
 * | PURCHASE
 * |--------------------------------------------------------------------------
 */

model Purchase {
  id String @id @default(uuid())

  tenantId    String  @map("tenant_id")
  supplierId  String  @map("supplier_id")
  createdById String? @map("created_by_id")

  purchaseNumber String  @map("purchase_number") @db.VarChar(100)
  invoiceNumber  String? @map("invoice_number") @db.VarChar(100)

  type   PurchaseType
  status PurchaseStatus @default(DRAFT)

  subtotal    Int @default(0)
  discount    Int @default(0)
  tax         Int @default(0)
  totalAmount Int @default(0) @map("total_amount")

  paymentStatus PurchasePaymentStatus @default(UNPAID) @map("payment_status")

  notes String? @db.Text

  purchasedAt DateTime? @map("purchased_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)

  items PurchaseItem[]

  receivings PurchaseReceiving[]

  payments PurchasePayment[]

  @@unique([tenantId, purchaseNumber])
  @@index([tenantId])
  @@index([tenantId, supplierId])
  @@index([tenantId, status])
  @@index([tenantId, paymentStatus])
  @@index([tenantId, purchasedAt])
  @@map("purchase")
}

/**
 * |--------------------------------------------------------------------------
 * | PURCHASE ITEM
 * |--------------------------------------------------------------------------
 */

model PurchaseItem {
  id String @id @default(uuid())

  purchaseId    String @map("purchase_id")
  rawMaterialId String @map("raw_material_id")
  unitId        String @map("unit_id")

  quantity Decimal @db.Decimal(15, 3)

  baseQuantity Decimal @map("base_quantity") @db.Decimal(15, 3)

  receivedBaseQuantity Decimal @default(0) @map("received_base_quantity") @db.Decimal(15, 3)

  unitPrice Int @map("unit_price")

  subtotal Int

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  purchase       Purchase                @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  rawMaterial    RawMaterial             @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)
  unit           Unit                    @relation(fields: [unitId], references: [id], onDelete: Restrict)
  receivingItems PurchaseReceivingItem[]

  @@index([purchaseId])
  @@index([rawMaterialId])
  @@index([unitId])
  @@map("purchase_item")
}

/**
 * |--------------------------------------------------------------------------
 * | PURCHASE RECEIVING
 * |--------------------------------------------------------------------------
 */

model PurchaseReceiving {
  id String @id @default(uuid())

  purchaseId String @map("purchase_id")

  receivingNumber String @map("receiving_number") @db.VarChar(100)

  receivedAt DateTime @default(now()) @map("received_at")

  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  items PurchaseReceivingItem[]

  @@unique([purchaseId, receivingNumber])
  @@index([purchaseId])
  @@index([receivedAt])
  @@map("purchase_receiving")
}

/**
 * |--------------------------------------------------------------------------
 * | PURCHASE RECEIVING ITEM
 * |--------------------------------------------------------------------------
 */

model PurchaseReceivingItem {
  id String @id @default(uuid())

  receivingId    String @map("receiving_id")
  purchaseItemId String @map("purchase_item_id")

  quantity Decimal @db.Decimal(15, 3)

  createdAt DateTime @default(now()) @map("created_at")

  receiving    PurchaseReceiving @relation(fields: [receivingId], references: [id], onDelete: Cascade)
  purchaseItem PurchaseItem      @relation(fields: [purchaseItemId], references: [id], onDelete: Restrict)

  @@index([receivingId])
  @@index([purchaseItemId])
  @@map("purchase_receiving_item")
}

/**
 * |--------------------------------------------------------------------------
 * | PURCHASE PAYMENT
 * |--------------------------------------------------------------------------
 */

model PurchasePayment {
  id String @id @default(uuid())

  purchaseId      String @map("purchase_id")
  paymentMethodId String @map("payment_method_id")

  amount Int

  reference String? @db.VarChar(150)
  notes     String? @db.Text

  paidAt DateTime @default(now()) @map("paid_at")

  createdAt DateTime @default(now()) @map("created_at")

  purchase      Purchase      @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)

  @@index([purchaseId])
  @@index([paymentMethodId])
  @@index([paidAt])
  @@map("purchase_payment")
}

/**
 * |--------------------------------------------------------------------------
 * | STOCK MOVEMENT
 * |--------------------------------------------------------------------------
 */

model StockMovement {
  id String @id @default(uuid())

  tenantId      String @map("tenant_id")
  rawMaterialId String @map("raw_material_id")

  type StockMovementType

  quantity Decimal @db.Decimal(15, 3)

  unitCost Int @default(0) @map("unit_cost")

  referenceId   String? @map("reference_id")
  referenceType String? @map("reference_type") @db.VarChar(50)

  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, rawMaterialId])
  @@index([tenantId, type])
  @@index([tenantId, createdAt])
  @@index([referenceId, referenceType])
  @@map("stock_movement")
}

/**
 * |--------------------------------------------------------------------------
 * | TRANSACTION
 * |--------------------------------------------------------------------------
 */

model Transaction {
  id String @id @default(uuid())

  tenantId  String  @map("tenant_id")
  cashierId String? @map("cashier_id")

  invoiceNumber String @map("invoice_number") @db.VarChar(100)

  status TransactionStatus @default(PENDING)

  subtotal Int @default(0)

  discount Int @default(0)

  serviceCharge Int @default(0) @map("service_charge")

  tax Int @default(0)

  total Int @default(0)

  totalPaid Int @default(0) @map("total_paid")

  change Int @default(0)

  totalHpp Int @default(0) @map("total_hpp")

  profit Int @default(0)

  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashier   User?    @relation(fields: [cashierId], references: [id], onDelete: Restrict)

  items TransactionItem[]

  payments Payment[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([tenantId, cashierId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@map("transaction")
}

/**
 * |--------------------------------------------------------------------------
 * | TRANSACTION ITEM
 * |--------------------------------------------------------------------------
 */

model TransactionItem {
  id String @id @default(uuid())

  transactionId String @map("transaction_id")
  productId     String @map("product_id")

  productName String @map("product_name") @db.VarChar(150)

  quantity Decimal @db.Decimal(15, 3)

  sellingPrice Int @map("selling_price")

  hpp Int @default(0)

  subtotal Int @default(0)

  profit Int @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product     Product     @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([productId])
  @@map("transaction_item")
}

/**
 * |--------------------------------------------------------------------------
 * | PAYMENT METHOD
 * |--------------------------------------------------------------------------
 */

model PaymentMethod {
  id String @id @default(uuid())

  tenantId String @map("tenant_id")

  code String @db.VarChar(50)
  name String @db.VarChar(100)

  usageType PaymentMethodUsage @default(BOTH) @map("usage_type")

  status Boolean @default(true)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  payments            PurchasePayment[]
  transactionPayments Payment[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, usageType])
  @@index([tenantId, status])
  @@map("payment_method")
}

/**
 * |--------------------------------------------------------------------------
 * | PAYMENT
 * |--------------------------------------------------------------------------
 */

model Payment {
  id String @id @default(uuid())

  transactionId   String @map("transaction_id")
  paymentMethodId String @map("payment_method_id")

  amount Int

  reference String? @db.VarChar(150)

  paidAt DateTime @default(now()) @map("paid_at")

  createdAt DateTime @default(now()) @map("created_at")

  transaction   Transaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  paymentMethod PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([paymentMethodId])
  @@index([paidAt])
  @@map("payment")
}

/**
 * |--------------------------------------------------------------------------
 * | REFRESH TOKEN
 * |--------------------------------------------------------------------------
 */

model RefreshToken {
  id String @id @default(cuid())

  userId   String  @map("user_id")
  tenantId String? @map("tenant_id")

  tokenHash String @map("token_hash") @db.VarChar(255)

  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  createdAt DateTime @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([userId])
  @@index([tenantId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_token")
}

/**
 * |--------------------------------------------------------------------------
 * | UNIT
 * |--------------------------------------------------------------------------
 */

model Unit {
  id String @id @default(uuid())

  code String @unique @db.VarChar(30)
  name String @unique @db.VarChar(50)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rawMaterials  RawMaterial[]
  purchaseItems PurchaseItem[]

  conversionsFrom UnitConversion[] @relation("conversionFrom")
  conversionsTo   UnitConversion[] @relation("conversionTo")

  rawMaterialConversionsFrom RawMaterialUnitConversion[] @relation("rawMaterialConversionFrom")
  rawMaterialConversionsTo   RawMaterialUnitConversion[] @relation("rawMaterialConversionTo")

  @@index([isActive])
  @@map("unit")
}

/**
 * |--------------------------------------------------------------------------
 * | UNIT CONVERSION
 * |--------------------------------------------------------------------------
 */

model UnitConversion {
  id String @id @default(uuid())

  fromUnitId String @map("from_unit_id")
  toUnitId   String @map("to_unit_id")

  multiplier Decimal @db.Decimal(15, 6)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  fromUnit Unit @relation("conversionFrom", fields: [fromUnitId], references: [id], onDelete: Restrict)

  toUnit Unit @relation("conversionTo", fields: [toUnitId], references: [id], onDelete: Restrict)

  @@unique([fromUnitId, toUnitId])
  @@index([fromUnitId])
  @@index([toUnitId])
  @@map("unit_conversion")
}

/**
 * |--------------------------------------------------------------------------
 * | RAW MATERIAL UNIT CONVERSION
 * |--------------------------------------------------------------------------
 */

model RawMaterialUnitConversion {
  id String @id @default(uuid())

  rawMaterialId String @map("raw_material_id")
  fromUnitId    String @map("from_unit_id")
  toUnitId      String @map("to_unit_id")

  multiplier Decimal @db.Decimal(15, 6)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  rawMaterial RawMaterial @relation(fields: [rawMaterialId], references: [id], onDelete: Cascade)
  fromUnit    Unit        @relation("rawMaterialConversionFrom", fields: [fromUnitId], references: [id], onDelete: Restrict)
  toUnit      Unit        @relation("rawMaterialConversionTo", fields: [toUnitId], references: [id], onDelete: Restrict)

  @@unique([rawMaterialId, fromUnitId, toUnitId])
  @@index([rawMaterialId])
  @@index([fromUnitId])
  @@index([toUnitId])
  @@map("raw_material_unit_conversion")
}

/**
 * |--------------------------------------------------------------------------
 * | AUDIT LOG
 * |--------------------------------------------------------------------------
 */

model AuditLog {
  id String @id @default(uuid())

  tenantId String? @map("tenant_id")
  userId   String? @map("user_id")

  action AuditLogAction

  module     String  @db.VarChar(50)
  entityType String  @map("entity_type") @db.VarChar(100)
  entityId   String? @map("entity_id")

  description String? @db.Text

  oldData Json? @map("old_data")
  newData Json? @map("new_data")

  ipAddress String? @map("ip_address") @db.VarChar(45)
  userAgent String? @map("user_agent") @db.Text

  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([tenantId, module])
  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_log")
}

/**
 * |--------------------------------------------------------------------------
 * | TRANSACTION SETTING
 * |--------------------------------------------------------------------------
 */

model TransactionSetting {
  id String @id @default(uuid())

  tenantId String @unique @map("tenant_id")

  taxEnabled Boolean @default(false) @map("tax_enabled")
  taxRate    Decimal @default(0) @map("tax_rate") @db.Decimal(5, 2)

  serviceChargeEnabled Boolean @default(false) @map("service_charge_enabled")
  serviceChargeRate    Decimal @default(0) @map("service_charge_rate") @db.Decimal(5, 2)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("transaction_setting")
}
